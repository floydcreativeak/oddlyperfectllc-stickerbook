---
/**
 * "Compare all packages": a button that opens a native <dialog> with a
 * stylised spreadsheet of the monthly packages. Desktop: a real table.
 * Phones: each row becomes a small card with the three values side by side,
 * so nothing scrolls sideways. Content: content/pricing.yml -> compare.
 * Native <dialog>: focus moves in, Esc closes, focus returns to the button.
 */
import { getPricing } from '../lib/content';
import Icon from './Icon.astro';
import CheckIcon from './CheckIcon.astro';
const pricing = await getPricing();
const c = pricing.compare;
const tiers = pricing.tiers;
const id = 'compare-dialog';
---
<div class="compare">
  <button type="button" class="btn btn--ink compare__open" data-compare-open aria-haspopup="dialog" aria-controls={id}>
    <Icon name="grid" /> <span>{c.button}</span>
  </button>

  <dialog class="compare__dialog" id={id} aria-labelledby={`${id}-title`}>
    <div class="compare__head">
      <div>
        <h2 id={`${id}-title`} class="compare__title">{c.heading}</h2>
        {c.intro && <p class="compare__intro">{c.intro}</p>}
      </div>
      <button type="button" class="compare__close" data-compare-close>
        <Icon name="close" /><span class="visually-hidden">{c.close}</span>
      </button>
    </div>
    <div class="compare__scroll">
      <table class="sheet" role="table">
        <thead>
          <tr role="row">
            <th scope="col" role="columnheader" class="sheet__corner">{c.featureLabel}</th>
            {tiers.map((t) => (
              <th scope="col" role="columnheader" class:list={['sheet__tier', `tone-${t.color}`, { 'sheet__tier--featured': t.featured }]}>
                <span class="sheet__tab hand">{t.tab}</span>
                <span class="sheet__name">{t.name}</span>
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {c.rows.map((r) => (
            <tr role="row">
              <th scope="row" role="rowheader" class="sheet__label">{r.label}</th>
              {tiers.map((t, i) => {
                const v = r.values[i] ?? '';
                const yes = v.toLowerCase() === 'yes';
                const no = v.toLowerCase() === 'no';
                return (
                  <td role="cell" class:list={['sheet__cell', { 'sheet__cell--featured': t.featured }]} data-tier={t.tab}>
                    <span class="sheet__mobile-tier" aria-hidden="true">{t.tab}</span>
                    {yes ? <span class="sheet__yes"><CheckIcon /><span class="visually-hidden">{c.yesLabel}</span></span>
                      : no ? <span class="sheet__no" aria-hidden="false"><span aria-hidden="true">&mdash;</span><span class="visually-hidden">{c.noLabel}</span></span>
                      : <span>{v}</span>}
                  </td>
                );
              })}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </dialog>
</div>

<script>
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLButtonElement>('[data-compare-open]').forEach((btn) => {
      if (btn.dataset.bound) return;
      btn.dataset.bound = '1';
      const dlg = document.getElementById(btn.getAttribute('aria-controls')!) as HTMLDialogElement | null;
      if (!dlg) return;
      btn.addEventListener('click', () => dlg.showModal());
      dlg.querySelector('[data-compare-close]')?.addEventListener('click', () => dlg.close());
      dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); }); // click the backdrop
      dlg.addEventListener('close', () => btn.focus());
    });
  });
</script>

<style>
  .compare { display: flex; justify-content: center; margin-top: var(--space-xl); }
  .compare__dialog {
    width: min(68rem, 96vw);
    max-height: 90vh;
    padding: 0;
    background: var(--c-paper);
    color: var(--c-ink);
    border: var(--border-chunky) solid var(--c-ink);
    border-radius: var(--radius-l);
    box-shadow: 10px 10px 0 var(--c-ink);
    overflow: hidden;
  }
  .compare__dialog[open] { display: flex; flex-direction: column; animation: cmp-in 380ms cubic-bezier(0.22, 1, 0.36, 1); }
  .compare__dialog::backdrop { background: rgb(31 23 38 / 0.78); }
  @keyframes cmp-in { from { opacity: 0; transform: translateY(18px) scale(0.97) rotate(-0.6deg); } }
  @media (prefers-reduced-motion: reduce) { .compare__dialog[open] { animation: none; } }
  .compare__head { display: flex; align-items: start; justify-content: space-between; gap: var(--space-m); padding: var(--space-l) var(--space-l) var(--space-s); border-bottom: 3px solid var(--c-ink); background: var(--c-mustard); }
  .compare__title { font-size: var(--step-3); }
  .compare__intro { margin-top: var(--space-2xs); font-weight: 600; }
  .compare__close { flex: none; display: grid; place-items: center; width: var(--tap-min); height: var(--tap-min); border-radius: 50%; border: 2px solid var(--c-ink); background: var(--c-paper); color: var(--c-ink); }
  .compare__scroll { overflow-y: auto; padding: 0 var(--space-m) var(--space-l); }

  /* The "spreadsheet": ruled rows, a header row of folder tabs */
  .sheet { width: 100%; border-collapse: separate; border-spacing: 0; font-size: var(--step--1); }
  .sheet th, .sheet td { padding: 0.7rem 0.8rem; text-align: left; vertical-align: top; border-bottom: 1.5px solid rgb(46 34 56 / 0.25); }
  .sheet thead th { position: sticky; top: 0; z-index: 1; border-bottom: 3px solid var(--c-ink); }
  .sheet__corner { background: var(--c-paper); font-family: var(--font-hand); font-size: var(--step-1); font-weight: 400; vertical-align: bottom; }
  .sheet__tier { background: var(--tone); color: var(--on-tone); border-radius: 14px 14px 0 0; }
  .sheet__tab { display: block; font-size: var(--step-0); line-height: 1; }
  .sheet__name { display: block; font-family: var(--font-display); font-weight: 400; font-size: var(--step-1); line-height: 1.1; margin-top: 0.15rem; }
  .sheet__label { font-weight: 800; width: 24%; }
  .sheet__cell--featured { background: rgb(232 185 74 / 0.18); }
  .sheet tbody tr:nth-child(odd) .sheet__label, .sheet tbody tr:nth-child(odd) .sheet__cell:not(.sheet__cell--featured) { background: rgb(46 34 56 / 0.04); }
  .sheet__yes :global(.check-icon) { width: 1.5rem; height: 1.5rem; color: var(--c-ink); }
  .sheet__no { color: rgb(46 34 56 / 0.5); font-weight: 800; }
  .sheet__mobile-tier { display: none; }
  .sheet tbody tr:first-child td, .sheet tbody tr:nth-child(2) td { font-family: var(--font-display); font-size: var(--step-1); }

  /* Phones: each row becomes a mini card with three columns */
  @media (max-width: 699.98px) {
    .sheet thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); } /* hidden, still read */
    .sheet, .sheet tbody { display: block; }
    .sheet tr { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.25rem; padding: var(--space-s) 0; border-bottom: 2px dashed rgb(46 34 56 / 0.35); }
    .sheet th, .sheet td { border: 0; padding: 0.35rem; background: none !important; }
    .sheet__label { grid-column: 1 / -1; width: auto; font-size: var(--step-0); }
    .sheet__cell { display: grid; gap: 0.15rem; align-content: start; border-radius: var(--radius-xs); }
    .sheet__cell--featured { background: rgb(232 185 74 / 0.22) !important; }
    .sheet__mobile-tier { display: block; font-family: var(--font-hand); font-size: var(--step-0); line-height: 1; }
    .sheet tbody tr:first-child td, .sheet tbody tr:nth-child(2) td { font-size: var(--step-0); }
  }
</style>
