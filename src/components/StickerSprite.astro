---
/**
 * One inline SVG sprite for every hand-drawn sticker, included once per page.
 * Each symbol = cream die-cut edge + coloured body + ink linework.
 * Colour comes from the --sf custom property on the sticker (see Sticker.astro).
 */
import { ART } from '../lib/sticker-art';
const symbols = Object.entries(ART).map(([name, a]) => {
  if (a.line) {
    return `<symbol id="st-${name}" viewBox="-12 -12 124 124"><g class="st-line-cut">${a.body}</g><g class="st-line">${a.body}</g><g class="st-line-color">${a.body}</g></symbol>`;
  }
  return `<symbol id="st-${name}" viewBox="-12 -12 124 124"><g class="st-cut">${a.body}${a.detail ?? ''}</g><g class="st-body">${a.body}</g>${a.detail ? `<g class="st-detail">${a.detail}</g>` : ''}</symbol>`;
});
---
<svg class="sticker-sprite" aria-hidden="true" focusable="false" width="0" height="0" set:html={symbols.join('')} />

<style is:global>
  .sticker-sprite { position: absolute; width: 0; height: 0; overflow: hidden; }
  .st-cut { fill: var(--sticker-outline); stroke: var(--sticker-outline); stroke-width: 16; stroke-linejoin: round; stroke-linecap: round; }
  .st-body { fill: var(--sf, var(--c-mustard)); stroke: var(--sticker-ink); stroke-width: 4.5; stroke-linejoin: round; }
  .st-detail { fill: none; stroke: var(--sticker-ink); stroke-width: 4.5; stroke-linecap: round; stroke-linejoin: round; }
  .st-line-cut { fill: none; stroke: var(--sticker-outline); stroke-width: 28; stroke-linecap: round; stroke-linejoin: round; }
  .st-line { fill: none; stroke: var(--sticker-ink); stroke-width: 12; stroke-linecap: round; stroke-linejoin: round; }
  .st-line-color { fill: none; stroke: var(--sf, var(--c-tangerine)); stroke-width: 4.5; stroke-linecap: round; stroke-linejoin: round; }
</style>
