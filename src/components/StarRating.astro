---
/** Hand-drawn SVG stars (never emoji). Announced as text, e.g. "5 out of 5 stars". */
import { getSite } from '../lib/content';
interface Props { rating: number; size?: string }
const { rating, size = '1.5rem' } = Astro.props;
const { ui } = await getSite();
const label = ui.ratingLabel.replace('{rating}', String(rating));
const STAR = 'M12 2.2l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17l-5.9 3.3 1.3-6.6L2.5 9.1l6.6-.8Z';
---
<span class="stars" role="img" aria-label={label} style={`--star-size:${size}`}>
  {Array.from({ length: 5 }, (_, i) => (
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" class:list={['star', { 'star--on': i < rating }]} style={`--r:${[-8, 4, -3, 7, -5][i]}deg`}>
      <path d={STAR} />
    </svg>
  ))}
</span>

<style>
  .stars { display: inline-flex; gap: 0.1rem; }
  .star { width: var(--star-size); height: var(--star-size); rotate: var(--r); overflow: visible; }
  .star path { fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linejoin: round; }
  .star--on path { fill: currentColor; }
</style>
