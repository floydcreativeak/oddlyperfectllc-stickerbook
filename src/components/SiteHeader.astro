---
/**
 * Glass header. Desktop: logo, page links (active dot), phone, socials, theme
 * toggle. Mobile: logo, phone number, theme toggle (page links live in the
 * bottom tab bar). Hides on scroll down, returns on scroll up (src/scripts/shell.ts).
 */
import { getSite } from '../lib/content';
import { PASTEL_VAR } from '../lib/colors';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import AnnouncementBar from './AnnouncementBar.astro';
import { isCurrent } from '../lib/nav';

const site = await getSite();
const path = Astro.url.pathname;
---
<header class="site-header" data-site-header>
  <AnnouncementBar />
  <div class="site-header__bar">
    <div class="site-header__inner">
      <a class="site-header__logo" href="/" aria-label={site.nav.homeLabel} data-wipe={PASTEL_VAR.tangerine}>
        <Logo />
      </a>

      <nav class="site-nav" aria-label={site.a11y.mainNav}>
        <ul role="list">
          {site.nav.links.map((l) => (
            <li>
              <a href={l.href} aria-current={isCurrent(path, l.href) ? 'page' : undefined} data-wipe={PASTEL_VAR[l.color]}>
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="site-header__actions">
        <a class="nav-phone" href={`tel:${site.phone.tel}`} data-track="call-nav">
          <Icon name="phone" />
          <span class="visually-hidden">{site.nav.callLabel}: </span>
          <span class="nav-phone__number">{site.phone.display}</span>
        </a>
        {site.socials.length > 0 && (
          <ul class="nav-socials" role="list">
            {site.socials.map((s) => (
              <li>
                <a href={s.url} rel="noopener me" target="_blank">
                  <Icon name={s.platform} />
                  <span class="visually-hidden">{s.label} {site.a11y.newTab}</span>
                </a>
              </li>
            ))}
          </ul>
        )}
        <ThemeToggle toLight={site.nav.themeToLight} toDark={site.nav.themeToDark} />
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: var(--z-nav);
    transition: transform var(--dur-base) var(--ease-out);
    will-change: transform;
  }
  .site-header[data-hidden] { transform: translateY(-110%); }
  .site-header__bar {
    background: var(--glass-bg);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(1.3);
    backdrop-filter: blur(var(--glass-blur)) saturate(1.3);
    border-bottom: 1px solid var(--glass-border);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-s);
    min-height: var(--nav-height-mobile);
    padding-inline: max(var(--gutter), env(safe-area-inset-left)) max(var(--gutter), env(safe-area-inset-right));
    padding-top: env(safe-area-inset-top, 0px);
    max-width: calc(var(--content-width) + 2 * var(--gutter) + 8rem);
    margin-inline: auto;
  }
  .site-header__logo {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    text-decoration: none;
    font-size: 0.95rem;
    flex: none;
  }

  /* Page links: desktop only */
  .site-nav { display: none; }
  .site-nav ul { display: flex; gap: clamp(0.25rem, 1vw, 0.75rem); }
  .site-nav a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    padding: 0 0.7rem;
    color: var(--text);
    font-weight: 700;
    text-decoration: none;
    border-radius: var(--radius-pill);
    transition: background-color var(--dur-fast) var(--ease-out), transform var(--dur-spring) var(--ease-spring);
  }
  .site-nav a:hover { background: color-mix(in srgb, var(--text) 8%, transparent); transform: translateY(-2px) rotate(-2deg); }
  /* Active page: small dot under the label (plus aria-current for AT) */
  .site-nav a::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: 4px;
    width: 7px;
    height: 7px;
    margin-left: -3.5px;
    border-radius: 50%;
    background: var(--text);
    scale: 0;
    transition: scale var(--dur-spring) var(--ease-spring);
  }
  .site-nav a[aria-current="page"]::after { scale: 1; }
  .site-nav a:hover::after { scale: 0.6; }
  .site-nav a[aria-current="page"]:hover::after { scale: 1.2; }

  .site-header__actions { display: flex; align-items: center; gap: 0.25rem; margin-left: auto; }
  .nav-phone {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    min-height: var(--tap-min);
    padding: 0 0.6rem;
    font-weight: 800;
    font-size: 0.95rem;
    font-variant-numeric: tabular-nums;
    color: var(--text);
    text-decoration: none;
    white-space: nowrap;
    border-radius: var(--radius-pill);
  }
  .nav-phone:hover { text-decoration: underline; text-decoration-thickness: 0.12em; }
  .nav-socials { display: none; }
  .nav-socials a {
    display: inline-grid;
    place-items: center;
    width: var(--tap-min);
    height: var(--tap-min);
    color: var(--text);
    border-radius: 50%;
    transition: transform var(--dur-spring) var(--ease-spring);
  }
  .nav-socials a:hover { transform: rotate(-10deg) scale(1.12); }

  @media (max-width: 379.98px) {
    .site-header__logo { font-size: 0.85rem; }
    .nav-phone { font-size: 0.85rem; padding-inline: 0.35rem; }
  }
  @media (min-width: 900px) {
    .site-header__inner { min-height: var(--nav-height); gap: var(--space-m); }
    .site-header__logo { font-size: 1.05rem; }
    .site-nav { display: block; }
    .nav-phone {
      padding: 0 1rem;
      background: var(--accent);
      color: var(--on-accent);
      border: var(--border-thin) solid var(--c-ink);
      box-shadow: 3px 3px 0 var(--c-ink);
      transition: transform var(--dur-spring) var(--ease-spring), box-shadow var(--dur-fast) var(--ease-out);
    }
    .nav-phone:hover { text-decoration: none; transform: translate(-1px, -2px) rotate(-2deg); box-shadow: 4px 5px 0 var(--c-ink); }
  }
  @media (min-width: 1180px) {
    .nav-socials { display: flex; }
  }
</style>
