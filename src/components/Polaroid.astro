---
/** Sticker-framed photo. Forgiving frame: cover-crop into a fixed ratio, so phone shots look tidy. */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  photo: { src: ImageMetadata; alt: string; placeholder: boolean };
  caption?: string;
  ratio?: string;
  rot?: number;
  sizes?: string;
  eager?: boolean;
  class?: string;
}
const { photo, caption, ratio = '4 / 5', rot = -2, sizes = '(min-width: 900px) 22rem, 70vw', eager = false, class: cls } = Astro.props;
---
<figure class:list={['polaroid', cls]} style={`--pol-rot:${rot}deg;--ratio:${ratio}`} data-tilt data-surface>
  <span class="polaroid__tape" aria-hidden="true"></span>
  <Picture
    src={photo.src}
    alt={photo.alt}
    formats={['avif', 'webp']}
    widths={[320, 480, 720, 960]}
    sizes={sizes}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
    class="polaroid__img"
  />
  {caption && <figcaption class="polaroid__cap">{caption}</figcaption>}
</figure>

<style>
  .polaroid {
    position: relative;
    margin: 0;
    padding: 12px 12px 14px;
    background: var(--c-paper);
    color: var(--c-ink);
    border: var(--border-thin) solid var(--c-ink);
    border-radius: 6px;
    box-shadow: var(--shadow-card);
    rotate: var(--pol-rot);
  }
  .polaroid :global(picture), .polaroid :global(img) { display: block; width: 100%; }
  .polaroid :global(img) { aspect-ratio: var(--ratio); height: auto; object-fit: cover; border-radius: 3px; background: var(--c-cream); }
  .polaroid__cap { font-family: var(--font-hand); font-size: var(--step-1); line-height: 1.1; padding: 0.6rem 0.2rem 0; }
  .polaroid__tape {
    position: absolute;
    top: -14px;
    left: 50%;
    width: 5.5rem;
    height: 1.6rem;
    margin-left: -2.75rem;
    background: rgb(233 185 74 / 0.75);
    border: 1px solid rgb(46 34 56 / 0.25);
    rotate: -4deg;
    z-index: 2;
  }
</style>
