---
/**
 * Placeholder wordmark until the client's SVG logo arrives (flagged in
 * content/site.yml -> logo.placeholder): a die-cut sticker with the name.
 * First word in the handwritten face, the rest in the slab. Everything sits
 * inside its own padded box, so nothing can be clipped by the header.
 * To use the real logo: replace the <span class="logo__badge"> with the SVG.
 */
import { getSite } from '../lib/content';
interface Props { size?: 'nav' | 'xl' }
const { size = 'nav' } = Astro.props;
const site = await getSite();
const [first, ...rest] = site.logo.text.split(' ');
---
<span class:list={['logo', `logo--${size}`]}>
  <span class="logo__badge">
    <span class="logo__first">{first}</span>{rest.length > 0 && <>{' '}<span class="logo__rest">{rest.join(' ')}</span></>}
  </span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    padding: 6px 8px; /* room for the die-cut edge + tilt, so nothing clips */
    line-height: 1;
  }
  .logo__badge {
    display: inline-flex;
    align-items: baseline;
    gap: 0.28em;
    padding: 0.32em 0.62em 0.38em;
    background: var(--accent);
    color: var(--c-ink);
    border: 2px solid var(--c-ink);
    border-radius: 14px 9px 14px 9px;
    outline: 3px solid var(--sticker-outline);
    box-shadow: 0 3px 6px rgb(var(--shadow-color) / 0.25);
    rotate: -3deg;
    white-space: nowrap;
    transition: rotate var(--dur-spring) var(--ease-spring), scale var(--dur-spring) var(--ease-spring);
  }
  .logo__first { font-family: var(--font-hand); font-size: 1.12em; }
  .logo__rest { font-family: var(--font-display); font-size: 1em; letter-spacing: -0.01em; }
  .logo--xl { font-size: clamp(1.6rem, 1rem + 3vw, 3rem); }
  @media (hover: hover) { :global(a:hover) > .logo .logo__badge { rotate: 2deg; scale: 1.04; } }
</style>
