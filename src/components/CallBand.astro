---
/** Closing call-to-action band for inner pages. Copy comes from each page's content file. */
import { getSite, getStickers } from '../lib/content';
import Sticker from './Sticker.astro';
import { BLOCK_VAR, type Pastel } from '../lib/colors';
interface Props { heading: string; body: string; label: string; color?: Pastel }
const { heading, body, label, color = 'tangerine' } = Astro.props;
const site = await getSite();
const [st] = await getStickers(['sparkle']);
---
<section class="block edge edge--zigzag callband" style={`--block-color:${BLOCK_VAR[color]}`} aria-labelledby="callband-title">
  <div class="wrap callband__inner">
    <div>
      <h2 id="callband-title" class="callband__title">{heading}</h2>
      <p class="lede">{body}</p>
    </div>
    <div class="callband__action">
      <Sticker sticker={st} size="5.5rem" class="callband__st" />
      <a class="btn btn--call btn--lg" href={`tel:${site.phone.tel}`} data-track="call-band">
        <span class="btn__label">{label}</span>
        <span class="btn__number">{site.phone.display}</span>
      </a>
    </div>
  </div>
</section>

<style>
  .callband { padding-bottom: calc(var(--space-section) + var(--radius-xl)); }
  .callband__inner { display: grid; gap: var(--space-xl); align-items: center; }
  .callband__title { font-size: var(--step-4); max-width: 14ch; margin-bottom: var(--space-s); }
  .callband__action { position: relative; justify-self: start; }
  .callband__action :global(.callband__st) { position: absolute; right: -1rem; top: -3.5rem; z-index: 2; }
  @media (min-width: 900px) { .callband__inner { grid-template-columns: 1.2fr 0.8fr; } .callband__action { justify-self: end; } }
</style>
