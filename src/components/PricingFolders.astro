---
/**
 * Monthly packages as labelled folders; the featured one peeks up with a sticker.
 *  - compact (home page): first few inclusions + a "see the full list" link,
 *    then the "also on the menu" price tags.
 *  - full (pricing page): best-for, every inclusion, the example and notes.
 * Every word and price comes from content/pricing.yml.
 */
import { getPricing, getSite, getStickers } from '../lib/content';
import { withBase } from '../lib/url';
import Sticker from './Sticker.astro';
import CheckIcon from './CheckIcon.astro';
interface Props { compact?: boolean; headingLevel?: 'h2' | 'h3' }
const { compact = false, headingLevel = 'h3' } = Astro.props;
const H = headingLevel;
const pricing = await getPricing();
const site = await getSite();
const stickerIds = pricing.tiers.map((t) => t.sticker).filter(Boolean) as string[];
const stickerList = await getStickers(stickerIds);
const stickerFor = (id?: string) => stickerList.find((s) => s.id === id);
const SHOW = 5;
---
<div class="folders" id={compact ? undefined : 'tiers'}>
  {pricing.tiers.map((t, i) => {
    const st = stickerFor(t.sticker);
    const shown = compact ? t.features.slice(0, SHOW) : t.features;
    const more = t.features.length - shown.length;
    return (
      <article class:list={['folder', `tone-${t.color}`, { 'folder--featured': t.featured }]} style={`--rise-i:${i}`} data-rise>
        <p class="folder__tab" aria-hidden="true">{t.tab}</p>
        <div class="folder__body" data-surface>
          {st && <Sticker sticker={st} size="6rem" class="folder__sticker" />}
          <H class="folder__name">{t.name}</H>
          <div class="folder__prices">
            <p class="folder__price">
              <span class="folder__amount">{t.price}</span>
              <span class="folder__cadence">{t.cadence}</span>
            </p>
            <p class="folder__plan">{pricing.priceLabels.flex}</p>
            {t.altPrice && (
              <p class="folder__alt">{pricing.priceLabels.or} <strong>{t.altPrice}</strong> {pricing.priceLabels.monthly.toLowerCase()}</p>
            )}
          </div>
          <p class="folder__pitch">{t.pitch}</p>
          {!compact && (
            <p class="folder__best"><span class="folder__label">{pricing.bestForLabel}:</span> {t.bestFor}</p>
          )}
          <p class="folder__inc">{pricing.includesLabel}</p>
          <ul class="checklist" role="list">
            {shown.map((f) => <li><CheckIcon /><span>{f}</span></li>)}
          </ul>
          {more > 0 && (
            <a class="folder__more" href={withBase('/pricing/#tiers')}>{pricing.moreLabel.replace('{n}', String(more))}</a>
          )}
          {!compact && t.example && (
            <p class="folder__example"><span class="folder__label">{pricing.exampleLabel}:</span> {t.example}</p>
          )}
          {!compact && t.notes.length > 0 && (
            <ul class="folder__notes" role="list">{t.notes.map((n) => <li>{n}</li>)}</ul>
          )}
          <a class:list={['btn', t.featured ? 'btn--accent' : 'btn--ink', 'folder__cta']} href={`tel:${site.phone.tel}`} data-track="call-pricing">{t.cta}</a>
        </div>
      </article>
    );
  })}
</div>

{compact && pricing.extras.length > 0 && (
  <div class="addons">
    <H class="addons__title">{pricing.extrasHeading}</H>
    <ul class="addons__list" role="list">
      {pricing.extras.map((a, i) => (
        <li class="tag" style={`--tag-rot:${[-3, 2, -1.5, 3][i % 4]}deg;--rise-i:${i}`} data-rise data-surface>
          <a class="tag__shape" href={withBase(a.href)}>
            <span class="tag__face">
              <span class="tag__hole" aria-hidden="true"></span>
              <span class="tag__name">{a.name}</span>
              <span class="tag__price">{a.price}</span>
              {a.note && <span class="tag__note">{a.note}</span>}
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
)}

<style>
  .folders { display: grid; gap: var(--space-2xl) var(--space-l); padding-top: var(--space-l); align-items: start; }
  @media (min-width: 960px) { .folders { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .folder { position: relative; }
  .folder__tab {
    position: absolute;
    top: -2.1rem;
    left: 0;
    max-width: none;
    padding: 0.4rem 1.2rem 0.6rem;
    background: var(--tone);
    color: var(--on-tone);
    font-family: var(--font-hand);
    font-size: var(--step-1);
    line-height: 1;
    border: var(--border-chunky) solid var(--c-ink);
    border-bottom: 0;
    border-radius: 16px 22px 0 0;
  }
  .folder__body {
    position: relative;
    display: grid;
    gap: var(--space-s);
    padding: var(--space-l);
    background: var(--tone);
    color: var(--on-tone);
    border: var(--border-chunky) solid var(--c-ink);
    border-radius: var(--radius-folder);
    box-shadow: var(--shadow-pop);
  }
  .folder__name { font-size: var(--step-2); padding-right: 3rem; }
  .folder__prices { display: grid; gap: 0.1rem; }
  .folder__price { display: flex; align-items: baseline; gap: 0.4rem; flex-wrap: wrap; }
  .folder__amount { font-family: var(--font-display); font-size: var(--step-4); line-height: 1; }
  .folder__cadence { font-weight: 700; }
  .folder__plan { font-family: var(--font-hand); font-size: var(--step-1); line-height: 1; }
  .folder__alt { font-size: var(--step--1); font-weight: 600; }
  .folder__pitch { font-weight: 700; }
  .folder__best, .folder__example { font-size: var(--step--1); }
  .folder__label { font-weight: 800; }
  .folder__inc { font-family: var(--font-hand); font-size: var(--step-1); line-height: 1; padding-top: var(--space-2xs); border-top: 2px dashed currentColor; }
  .folder__more { font-weight: 800; color: inherit; justify-self: start; min-height: var(--tap-min); display: inline-flex; align-items: center; }
  .folder__notes { list-style: none; padding: var(--space-s); display: grid; gap: var(--space-2xs); font-size: var(--step--1); border: 2px dashed currentColor; border-radius: var(--radius-s); }
  .folder__cta { justify-self: start; margin-top: var(--space-xs); }
  .folder :global(.folder__sticker) { position: absolute; top: -3rem; right: -0.8rem; z-index: 3; }
  .folder--featured { z-index: 2; }
  @media (min-width: 960px) {
    .folder--featured { translate: 0 -1.6rem; }
    .folder--featured .folder__body { box-shadow: 9px 9px 0 var(--c-ink); }
  }

  .addons { margin-top: var(--space-2xl); }
  .addons__title { font-size: var(--step-3); margin-bottom: var(--space-l); }
  .addons__list { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr)); gap: var(--space-l); }
  .tag { rotate: var(--tag-rot); filter: drop-shadow(3px 4px 0 var(--c-ink)); max-width: none; }
  .tag__shape { display: block; height: 100%; padding: 2.5px; background: var(--c-ink); clip-path: polygon(1.6rem 0, 100% 0, 100% 100%, 1.6rem 100%, 0 50%); border-radius: 0 14px 14px 0; color: inherit; text-decoration: none; transition: transform var(--dur-spring) var(--ease-spring); }
  a.tag__shape:hover { transform: translateX(4px) rotate(-1.5deg); }
  .tag__face {
    position: relative;
    display: grid;
    gap: 0.2rem;
    height: 100%;
    padding: var(--space-m) var(--space-m) var(--space-m) 3.2rem;
    background: var(--surface);
    color: var(--text);
    clip-path: polygon(calc(1.6rem - 1px) 0, 100% 0, 100% 100%, calc(1.6rem - 1px) 100%, 1px 50%);
    border-radius: 0 12px 12px 0;
  }
  .tag__hole { position: absolute; left: 1.3rem; top: 50%; width: 0.8rem; height: 0.8rem; margin-top: -0.4rem; border-radius: 50%; border: 2px solid var(--c-ink); background: var(--block-color, var(--bg)); }
  .tag__name { font-weight: 800; }
  .tag__price { font-family: var(--font-display); font-size: var(--step-2); line-height: 1.05; }
  .tag__note { font-size: var(--step--1); }
</style>
