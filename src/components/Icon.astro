  | 'facebook' | 'instagram' | 'linkedin' | 'x' | 'tiktok' | 'youtube' | 'threads' | 'google'
  | 'arrow-right' | 'arrow-up' | 'clock' | 'download' | 'close' | 'plus' | 'list' | 'grid' | 'move';
const { name, size = '1.25em', class: cls } = Astro.props;

