---
/**
 * Pricing: decision info first, fine print folded away.
 *   packages (compact + compare) -> two ways to pay -> good-to-know numbers
 *   -> projects & events at a glance -> no kickbacks -> fine print accordion
 *   -> money FAQ -> call band.
 * Prices: content/pricing.yml. Policies: content/policies.yml.
 */
import { existsSync } from 'node:fs';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import PricingFolders from '../components/PricingFolders.astro';
import FaqList from '../components/FaqList.astro';
import CallBand from '../components/CallBand.astro';
import CheckIcon from '../components/CheckIcon.astro';
import Icon from '../components/Icon.astro';
import { getPricing, getPolicies, getSite, getHome } from '../lib/content';
import { withBase } from '../lib/url';
const p = await getPricing();
const pol = await getPolicies();
const site = await getSite();
const { services: servicesCopy } = await getHome();
const brochure = site.brochure && existsSync(`public${site.brochure.file}`) ? site.brochure : undefined;

// Fine print, split into two independent columns (expanding one never stretches another).
const fine = [
  { key: 'flex', h: pol.flex.heading, s: pol.flex.summary },
  { key: 'rush', h: pol.rush.heading, s: pol.rush.summary },
  { key: 'notIncluded', h: pol.notIncluded.heading, s: pol.notIncluded.summary },
  { key: 'travel', h: pol.travel.heading, s: pol.travel.summary },
  { key: 'payments', h: pol.payments.heading, s: pol.payments.summary },
  { key: 'community', h: pol.community.heading, s: pol.community.summary },
  { key: 'noSurprises', h: pol.noSurprises.heading, s: pol.noSurprises.summary },
  { key: 'delays', h: pol.delays.heading, s: pol.delays.summary },
  { key: 'relationships', h: pol.relationships.heading, s: pol.relationships.summary },
  { key: 'revisions', h: pol.revisions.heading, s: pol.revisions.summary },
];
const half = Math.ceil(fine.length / 2);
const columns = [fine.slice(0, half), fine.slice(half)];
const tones = ['mint', 'blush', 'peri', 'mustard', 'cream'];
const FACT_TONE = ['blush', 'mint', 'peri', 'mustard', 'tangerine', 'cream'];
---
<BaseLayout title={p.seo.title} description={p.seo.description}>
  <PageHeader eyebrow={p.eyebrow} heading={p.heading} intro={p.intro} color="mustard" stickers={p.stickers}>
    {brochure && (
      <a class="btn btn--ink header-dl" href={withBase(brochure.file)} download>
        <Icon name="download" /> <span>{brochure.label}</span>
      </a>
    )}
  </PageHeader>

  <!-- 1. Packages -->
  <section class="block block--plain edge edge--zigzag" aria-label={p.heading}>
    <div class="wrap">
      <PricingFolders compact showBestFor showExtras={false} headingLevel="h2" anchor="tiers" />
      {p.footnote && <p class="pricing-footnote">{p.footnote}</p>}
    </div>
  </section>

  <!-- 2. Two ways to pay -->
  <section class="block block--contact edge edge--wave" aria-labelledby="ways-title">
    <div class="wrap">
      <header class="section-head">
        <h2 id="ways-title">{pol.twoWays.heading}</h2>
        {pol.twoWays.intro && <p>{pol.twoWays.intro}</p>}
      </header>
      <div class="ways">
        {[pol.twoWays.flex, pol.twoWays.monthly].map((w, i) => (
          <article class:list={['way', i ? 'tone-cream' : 'tone-mustard', { 'way--best': !i }]} data-surface>
            {w.badge && <p class="way__badge hand">{w.badge}</p>}
            <h3 class="way__title">{w.title}</h3>
            <ul class="checklist" role="list">{w.points.map((x) => <li><CheckIcon /><span>{x}</span></li>)}</ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. Good to know: the numbers, as big stickers -->
  <section class="block block--plain edge edge--scallop" id="fees" aria-labelledby="facts-title">
    <div class="wrap">
      <header class="section-head"><h2 id="facts-title">{pol.factsHeading}</h2></header>
      <ul class="facts" role="list">
        {p.addons.map((a, i) => (
          <li class:list={['fact', `tone-${FACT_TONE[i % FACT_TONE.length]}`]} style={`--f-rot:${[-2.5, 1.8, -1.2, 2.4, -1.8, 1.2][i % 6]}deg;--rise-i:${i % 3}`} data-rise data-surface>
            <span class="fact__value">{a.price}</span>
            <span class="fact__label">{a.name}</span>
            {a.note && <span class="fact__note">{a.note}</span>}
          </li>
        ))}
        <li class="fact tone-mint" style="--f-rot:-1.5deg;--rise-i:2" data-rise data-surface>
          <span class="fact__value">{pol.community.badge}</span>
          <span class="fact__label">{pol.community.heading}</span>
          <span class="fact__note">{pol.community.tagline}</span>
        </li>
      </ul>
    </div>
  </section>

  <!-- 4. Projects & events at a glance -->
  <section class="block block--services edge edge--tilt" aria-labelledby="glance-projects">
    <div class="wrap glance">
      {[
        { id: 'glance-projects', heading: p.projectsHeading, rows: p.projects.map((x) => ({ name: x.name, price: x.price })), href: '/services/#projects' },
        { id: 'glance-events', heading: p.eventsHeading, rows: p.events.map((x) => ({ name: x.name, price: x.price })), href: '/services/#events' },
      ].map((g) => (
        <article class="menu" data-surface>
          <h2 id={g.id} class="menu__title">{g.heading}</h2>
          <dl class="menu__rows">
            {g.rows.map((r) => <div class="menu__row"><dt>{r.name}</dt><dd>{r.price}</dd></div>)}
          </dl>
          <a class="menu__more" href={withBase(g.href)}>{servicesCopy.detailsLabel} <Icon name="arrow-right" /></a>
        </article>
      ))}
    </div>
  </section>

  <!-- 5. The big promise -->
  <section class="block block--reviews edge edge--scallop" aria-labelledby="kick-title">
    <div class="wrap kick">
      <h2 id="kick-title" class="kick__title">{pol.noKickbacks.heading}</h2>
      <ul class="kick__list" role="list">{pol.noKickbacks.items.map((x, i) => <li class={`tone-${['mint', 'blush', 'mustard', 'peri', 'tangerine', 'mint'][i % 6]}`} data-surface>{x}</li>)}</ul>
      <p class="kick__kicker hand">{pol.noKickbacks.kicker}</p>
    </div>
  </section>

  <!-- 6. The fine print, folded away -->
  <section class="block block--plain edge edge--wave" aria-labelledby="fine-title">
    <div class="wrap">
      <header class="section-head">
        <h2 id="fine-title">{pol.heading}</h2>
        <p>{pol.intro}</p>
      </header>
      <div class="fine">
        {columns.map((col, ci) => (
          <div class="fine__col">
            {col.map((f, i) => (
              <details class:list={['policy', `tone-${tones[(ci * half + i) % tones.length]}`]} data-surface>
                <summary class="policy__q">
                  <span class="policy__text">
                    <span class="policy__title">{f.h}</span>
                    {f.s && <span class="policy__summary">{f.s}</span>}
                  </span>
                  <span class="policy__icon" aria-hidden="true"><Icon name="plus" /></span>
                </summary>
                <div class="policy__body">
                  {f.key === 'flex' && <>
                    <p class="hand policy__tag">{pol.flex.tagline}</p>
                    <h3 class="policy__sub">{pol.flex.rulesHeading}</h3>
                    <ul class="checklist" role="list">{pol.flex.rules.map((r) => <li><CheckIcon /><span>{r}</span></li>)}</ul>
                    <h3 class="policy__sub">{pol.flex.benefitsHeading}</h3>
                    <ul class="checklist" role="list">{pol.flex.benefits.map((r) => <li><CheckIcon /><span>{r}</span></li>)}</ul>
                  </>}
                  {f.key === 'community' && <>
                    <p>{pol.community.body}</p>
                    <ul class="checklist" role="list">{pol.community.points.map((r) => <li><CheckIcon /><span>{r}</span></li>)}</ul>
                  </>}
                  {f.key === 'noSurprises' && <p>{pol.noSurprises.body}</p>}
                  {f.key === 'notIncluded' && <>
                    {pol.notIncluded.intro && <p>{pol.notIncluded.intro}</p>}
                    <ul class="chips" role="list">{pol.notIncluded.items.map((x) => <li>{x}</li>)}</ul>
                  </>}
                  {f.key === 'rush' && [pol.rush, pol.eventRush].map((t) => (
                    <div class="policy__table">
                      <h3 class="policy__sub">{t.heading}</h3>
                      {t.intro && <p>{t.intro}</p>}
                      <table class="rate">
                        <thead><tr><th scope="col">{t.whenLabel}</th><th scope="col">{t.feeLabel}</th></tr></thead>
                        <tbody>{t.rows.map((r) => <tr><td>{r.when}</td><td class="rate__fee">{r.fee}</td></tr>)}</tbody>
                      </table>
                      {t.note && <p class="policy__note">{t.note}</p>}
                    </div>
                  ))}
                  {f.key === 'delays' && <>
                    <p>{pol.delays.body}</p>
                    <ol class="policy__ol">{pol.delays.options.map((o) => <li>{o}</li>)}</ol>
                  </>}
                  {f.key === 'travel' && <>
                    <p><strong>{pol.travel.local}</strong></p>
                    <p>{pol.travel.outside}</p>
                    <p>{pol.travel.expenses}</p>
                  </>}
                  {f.key === 'relationships' && <p>{pol.relationships.body}</p>}
                  {f.key === 'revisions' && <p>{pol.revisions.body}</p>}
                  {f.key === 'payments' && <>
                    {pol.payments.intro && <p>{pol.payments.intro}</p>}
                    <ul class="checklist" role="list">{pol.payments.monthly.map((x) => <li><CheckIcon /><span>{x}</span></li>)}</ul>
                    <h3 class="policy__sub">{pol.payments.projectsHeading}</h3>
                    <table class="rate">
                      <thead><tr><th scope="col">{pol.payments.projectLabel}</th><th scope="col">{pol.payments.scheduleLabel}</th></tr></thead>
                      <tbody>{pol.payments.projects.map((r) => <tr><td>{r.project}</td><td>{r.schedule}</td></tr>)}</tbody>
                    </table>
                  </>}
                </div>
              </details>
            ))}
          </div>
        ))}
      </div>
    </div>
  </section>

  {p.faq.length > 0 && (
    <section class="block block--contact edge edge--zigzag" aria-labelledby="money-faq">
      <div class="wrap money">
        <h2 id="money-faq" class="money__title">{p.faqHeading}</h2>
        <FaqList items={p.faq} name="pricing-faq" />
      </div>
    </section>
  )}
  <CallBand {...p.cta} color="blush" />
</BaseLayout>

<style>
  .header-dl { justify-self: start; margin-top: var(--space-s); }
  .pricing-footnote { margin-top: var(--space-2xl); font-weight: 600; max-width: 62ch; padding-left: var(--space-s); border-left: 4px solid var(--accent); }

  /* Two ways to pay */
  .ways { display: grid; gap: var(--space-xl); }
  @media (min-width: 760px) { .ways { grid-template-columns: 1fr 1fr; align-items: start; } }
  .way {
    position: relative; display: grid; gap: var(--space-s); padding: var(--space-xl) var(--space-l) var(--space-l);
    background: var(--tone); color: var(--on-tone);
    border: var(--border-chunky) solid var(--c-ink); border-radius: var(--radius-wonky); box-shadow: var(--shadow-pop);
  }
  .way--best { rotate: -1deg; }
  .way:not(.way--best) { rotate: 1deg; }
  .way__badge {
    position: absolute; top: -1.1rem; right: 1.2rem; padding: 0.25rem 0.8rem; font-size: var(--step-1); line-height: 1;
    background: var(--c-paper); color: var(--c-ink); border: 2px solid var(--c-ink); border-radius: var(--radius-s);
    outline: 4px solid var(--sticker-outline); rotate: 4deg; max-width: none;
  }
  .way__title { font-size: var(--step-3); }

  /* Good to know: big numbers as stickers */
  .facts { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr)); gap: var(--space-xl) var(--space-l); }
  .fact {
    position: relative; display: grid; gap: 0.25rem; align-content: start; max-width: none;
    padding: var(--space-l); background: var(--tone); color: var(--on-tone);
    border: var(--border-thin) solid var(--c-ink); border-radius: var(--radius-m) var(--radius-s) var(--radius-m) var(--radius-s);
    outline: 5px solid var(--sticker-outline); box-shadow: var(--shadow-sticker); rotate: var(--f-rot);
  }
  .fact__value { font-family: var(--font-display); font-size: clamp(1.9rem, 1.4rem + 1.3vw, 2.6rem); line-height: 1; white-space: nowrap; }
  .fact__label { font-weight: 800; }
  .fact__note { font-size: var(--step--1); }

  /* At a glance */
  .glance { display: grid; gap: var(--space-xl); align-items: start; }
  @media (min-width: 960px) { .glance { grid-template-columns: 1fr 1fr; } }
  .menu { position: relative; display: grid; gap: var(--space-s); padding: var(--space-xl) var(--space-l); background: var(--surface); color: var(--text); border: var(--border-chunky) solid var(--c-ink); border-radius: var(--radius-m); box-shadow: var(--shadow-pop); }
  .menu:nth-child(1) { rotate: -0.6deg; }
  .menu:nth-child(2) { rotate: 0.8deg; }
  .menu__title { font-size: var(--step-3); }
  .menu__rows { display: grid; }
  .menu__row { display: flex; justify-content: space-between; align-items: baseline; gap: var(--space-s); padding: 0.65rem 0; border-top: 2px dashed currentColor; }
  .menu__row dt { font-weight: 800; }
  .menu__row dd { margin: 0; font-family: var(--font-display); font-size: var(--step-1); white-space: nowrap; }
  .menu__more { display: inline-flex; align-items: center; gap: 0.4em; min-height: var(--tap-min); font-weight: 800; color: var(--accent-text); justify-self: start; }

  /* The promise */
  .kick { display: grid; gap: var(--space-l); justify-items: start; }
  .kick__title { font-size: var(--step-4); max-width: 16ch; }
  .kick__list { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-s); }
  .kick__list li { position: relative; padding: 0.55rem 1rem; background: var(--tone); color: var(--on-tone); font-weight: 800; border: 2px solid var(--c-ink); border-radius: var(--radius-pill); outline: 4px solid var(--sticker-outline); max-width: none; }
  .kick__list li:nth-child(odd) { rotate: -2deg; }
  .kick__list li:nth-child(even) { rotate: 1.5deg; }
  .kick__kicker { font-size: var(--step-2); line-height: 1.15; color: var(--c-mustard); max-width: 30ch; }

  /* Fine print accordion */
  .fine { display: grid; gap: var(--space-s); align-items: start; }
  @media (min-width: 900px) { .fine { grid-template-columns: 1fr 1fr; gap: var(--space-l); } }
  .fine__col { display: grid; gap: var(--space-s); }
  .policy {
    position: relative; background: var(--tone); color: var(--on-tone);
    border: var(--border-thin) solid var(--c-ink); border-radius: var(--radius-m) var(--radius-s) var(--radius-m) var(--radius-s);
    box-shadow: 4px 4px 0 var(--c-ink); transition: translate var(--dur-spring) var(--ease-spring), box-shadow var(--dur-fast) var(--ease-out);
  }
  .policy[open] { translate: -2px -3px; box-shadow: 7px 7px 0 var(--c-ink); }
  .policy__q { display: flex; align-items: center; justify-content: space-between; gap: var(--space-s); padding: var(--space-s) var(--space-m); min-height: 4rem; cursor: pointer; list-style: none; }
  .policy__q::-webkit-details-marker { display: none; }
  .policy__text { display: grid; gap: 0.15rem; }
  .policy__title { font-weight: 800; font-size: var(--step-1); line-height: 1.2; }
  .policy__summary { font-size: var(--step--1); }
  .policy__icon { flex: none; display: grid; place-items: center; width: 2.2rem; height: 2.2rem; border-radius: 50%; background: var(--c-paper); color: var(--c-ink); border: 2px solid var(--c-ink); transition: rotate var(--dur-spring) var(--ease-spring); }
  .policy[open] .policy__icon { rotate: 135deg; }
  .policy__body { display: grid; gap: var(--space-s); padding: 0 var(--space-m) var(--space-m); font-size: var(--step--1); }
  .policy__sub { font-family: var(--font-body); font-size: var(--step-0); font-weight: 800; margin-top: var(--space-2xs); }
  .policy__tag { font-size: var(--step-1); }
  .policy__note { font-weight: 600; }
  .policy__ol { padding-left: 1.3em; display: grid; gap: var(--space-3xs); font-weight: 700; }
  .policy__table { display: grid; gap: var(--space-2xs); }
  .chips { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .chips li { padding: 0.3rem 0.75rem; border: 2px solid currentColor; border-radius: var(--radius-pill); font-weight: 700; max-width: none; }
  .rate { width: 100%; border-collapse: collapse; }
  .rate th { text-align: left; font-weight: 800; padding: 0.4rem 0.5rem 0.4rem 0; border-bottom: 3px solid currentColor; }
  .rate td { padding: 0.45rem 0.5rem 0.45rem 0; border-bottom: 2px dashed currentColor; vertical-align: top; }
  .rate__fee { font-family: var(--font-display); white-space: nowrap; }

  .money { display: grid; gap: var(--space-xl); }
  .money__title { font-size: var(--step-4); max-width: 12ch; }
  @media (min-width: 960px) { .money { grid-template-columns: 0.8fr 1.2fr; align-items: start; } }
</style>
