---
// Phase 1 smoke page: proves every collection loads and validates.
// Replaced by the real home page in Phase 3.
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';
import { getSite, getHome, getStickers, getServices, getReviews, getTeam, getGallery, getPricing } from '../lib/content';
const site = await getSite();
const home = await getHome();
const stickers = await getStickers(home.hero.stickers);
const [services, reviews, team, gallery, pricing] = await Promise.all([getServices(), getReviews(), getTeam(), getGallery(), getPricing()]);
---
<html lang="en">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>{home.seo.title}</title></head>
  <body>
    <main class="block block--hero">
      <div class="wrap stack">
        <h1>{home.hero.headline}</h1>
        <p class="lede">{home.hero.sub}</p>
        <a class="btn btn--call" href={`tel:${site.phone.tel}`}><span class="btn__label">{home.hero.callLabel}</span><span class="btn__number">{site.phone.display}</span></a>
        <p>{services.length} services, {reviews.length} reviews, {team.length} team, {gallery.length} photos, {pricing.tiers.length} tiers, {stickers.length} hero stickers.</p>
      </div>
    </main>
  </body>
</html>
