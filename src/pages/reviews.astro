---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ReviewWall from '../components/ReviewWall.astro';
import CallBand from '../components/CallBand.astro';
import { getPage, getReviews, getHome, getSite } from '../lib/content';
const page = await getPage('reviews');
const d = page.data;
const reviews = await getReviews();
const { reviews: copy } = await getHome();
const { ui } = await getSite();
const sources = [...new Set(reviews.map((r) => r.data.source))];
---
<BaseLayout title={d.title} description={d.description}>
  <PageHeader eyebrow={d.eyebrow} heading={d.heading} intro={d.intro} color={d.color} stickers={d.stickers} />
  <section class="block block--reviews edge edge--scallop" aria-labelledby="all-reviews">
    <div class="wrap">
      <h2 id="all-reviews" class="visually-hidden">{d.heading}</h2>
      {d.filterLabel && sources.length > 1 && (
        <div class="filters" role="group" aria-label={d.filterLabel} data-review-filter>
          <p class="filters__label hand" aria-hidden="true">{d.filterLabel}</p>
          <button type="button" aria-pressed="true" data-source="all">{d.allLabel}</button>
          {sources.map((s) => <button type="button" aria-pressed="false" data-source={s}>{ui.reviewSources[s]}</button>)}
        </div>
      )}
      <ReviewWall reviews={reviews} dragHint={copy.dragHint} listToggle={copy.listToggle} wallToggle={copy.wallToggle} id="all-wall" />
    </div>
  </section>
  {d.cta && <CallBand {...d.cta} color="mint" />}
</BaseLayout>

<script>
  document.addEventListener('astro:page-load', () => {
    const group = document.querySelector<HTMLElement>('[data-review-filter]');
    if (!group || group.dataset.bound) return;
    group.dataset.bound = '1';
    const buttons = [...group.querySelectorAll<HTMLButtonElement>('button')];
    buttons.forEach((b) => b.addEventListener('click', () => {
      const src = b.dataset.source;
      buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      document.querySelectorAll<HTMLElement>('#all-wall > li').forEach((li) => {
        const s = li.querySelector<HTMLElement>('[data-source]')?.dataset.source;
        li.hidden = src !== 'all' && s !== src;
      });
    }));
  });
</script>

<style>
  .filters { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-xs); margin-bottom: var(--space-l); }
  .filters__label { font-size: var(--step-1); margin-right: var(--space-xs); }
  .filters button {
    min-height: var(--tap-min);
    padding: 0 1rem;
    font-weight: 800;
    color: inherit;
    border: 2px solid currentColor;
    border-radius: var(--radius-pill);
    transition: transform var(--dur-spring) var(--ease-spring);
  }
  .filters button[aria-pressed="true"] { background: var(--c-mustard); color: var(--c-ink); border-color: var(--c-mustard); }
  .filters button:hover { transform: rotate(-3deg); }
</style>
